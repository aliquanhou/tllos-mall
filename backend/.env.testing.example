# TLL OS Mall - Testing Environment
# Copy this file to .env.testing and fill in your test database credentials.
# NEVER commit .env.testing with real credentials.

APP_NAME="TLL OS Mall Test"
APP_ENV=testing
APP_KEY=base64:testkeyforpaymenttestingonlydonotuseforprod
APP_DEBUG=true
APP_URL=https://mall.tllos.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tllos_mall_test
DB_USERNAME=your_test_db_user
DB_PASSWORD=your_test_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
